{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "800px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": true,
      "link": true,
      "palette": [
        {
          "slug": "primary",
          "color": "#2563eb",
          "name": "Primary"
        },
        {
          "slug": "secondary",
          "color": "#1e1e1e",
          "name": "Secondary"
        },
        {
          "slug": "surface",
          "color": "#f5f5f5",
          "name": "Surface"
        },
        {
          "slug": "dark",
          "color": "#121212",
          "name": "Dark"
        },
        {
          "slug": "light",
          "color": "#ffffff",
          "name": "Light"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "lineHeight": true,
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Medium"
        },
        {
          "slug": "large",
          "size": "1.5rem",
          "name": "Large"
        },
        {
          "slug": "x-large",
          "size": "2.5rem",
          "name": "Extra Large"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "units": [ "%", "px", "em", "rem", "vh", "vw" ],
      "spacingSizes": [
        { "slug": "20", "size": "0.44rem", "name": "2X Small" },
        { "slug": "30", "size": "0.67rem", "name": "X Small" },
        { "slug": "40", "size": "1rem", "name": "Small" },
        { "slug": "50", "size": "1.5rem", "name": "Medium" },
        { "slug": "60", "size": "2.25rem", "name": "Large" },
        { "slug": "70", "size": "3.38rem", "name": "X Large" },
        { "slug": "80", "size": "5.06rem", "name": "2X Large" }
      ]
    }
  }
}
