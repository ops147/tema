# Distribution exclusions — dev files that must not ship in the plugin ZIP
# (consumed by scripts/zip.js).

.git/
node_modules/
scripts/
dist/

.distignore
.gitignore
package.json
package-lock.json
tailwind.config.js

# Tailwind source — only the compiled assets/css/tailwind.css ships.
assets/css/tailwind.input.css
assets/css/tw/

# Editor/OS noise and backup artefacts.
*.bak
*.bak-*
*.log
*.snapshot/
.DS_Store
Thumbs.db
